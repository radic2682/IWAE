{
  "name": "iwae",
  "version": "0.1.10",
  "description": "PDF notes woven to their source: a local-first PDF reader that links highlights and memos back to the exact spot",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "release:check": "node scripts/release-preflight.mjs",
    "release:scan": "node scripts/release-scan.mjs",
    "release:local": "node scripts/release-local.mjs",
    "release:build": "npm run release:check && npm run installer:assets && node scripts/write-updater-config.mjs && tauri build --config src-tauri/tauri.updater.conf.json",
    "installer:assets": "node scripts/generate-installer-assets.mjs",
    "verify:ocr-dist": "node scripts/verify-ocr-dist.mjs",
    "test:release-scripts": "node --test scripts/generate-installer-assets.test.mjs scripts/release-preflight.test.mjs scripts/release-scan.test.mjs scripts/verify-ocr-dist.test.mjs scripts/write-update-manifest.test.mjs scripts/write-updater-config.test.mjs scripts/build-emoji-data.test.mjs scripts/fetch-pdfium.test.mjs scripts/release-local.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "pdfium:fetch": "node scripts/fetch-pdfium.mjs",
    "tauri": "tauri",
    "emoji:data": "node scripts/build-emoji-data.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "2.9.0",
    "@xyflow/react": "^12.11.6",
    "dompurify": "^3.4.17",
    "gsap": "^3.15.1",
    "markdown-it": "^15.0.3",
    "onnxruntime-web": "1.24.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "twemoji-colr-font": "^15.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "emojibase-data": "^17.0.0",
    "fontkit": "^2.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
