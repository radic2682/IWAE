{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IWAE Setup",
  "version": "../../package.json",
  "identifier": "dev.iwae.setup",
  "mainBinaryName": "iwae-setup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5181",
    "beforeDevCommand": "node ../node_modules/vite/bin/vite.js --config vite.config.ts",
    "beforeBuildCommand": "npm --prefix .. run setup:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IWAE 설치 / IWAE Setup",
        "width": 480,
        "height": 320,
        "resizable": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#11141a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
