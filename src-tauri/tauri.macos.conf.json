{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "IWAE",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#171a1e",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 19 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": [
      "binaries/libpdfium.dylib",
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md",
      "licenses/pdfium-licenses.txt"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
