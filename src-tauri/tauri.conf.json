{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IWAE",
  "version": "0.1.14",
  "identifier": "dev.iwae.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IWAE",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#171a1e",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; form-action 'none'; font-src 'self' data:; img-src 'self' data: blob: iwae: http://iwae.localhost; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost iwae: http://iwae.localhost http://127.0.0.1:11434 http://localhost:11434 ws://127.0.0.1:11434 ws://localhost:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "IWAE.PDF",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": ["iwtheme"],
        "name": "IWAE.Theme",
        "description": "IWAE theme",
        "role": "Viewer"
      }
    ],
    "resources": [
      "binaries/pdfium.dll",
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md",
      "licenses/pdfium-licenses.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": true,
        "startMenuFolder": "IWAE",
        "installerHooks": "installer/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
